{
  "name": "kuudu-breathe-the-lantern-home",
  "productName": "Kuudu: Breathe the Lantern Home",
  "version": "0.1.0",
  "description": "A relaxing rhythm game where you guide a glowing Vesak lantern down a night river with your breath, using the Presage SmartSpectra SDK.",
  "author": "Chamod Dhananjaya",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhananjaya-hbc/Kuudu-Breathe-the-Lantern-Home.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@smartspectra/node-sdk": "~3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
